rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Current app uses its own portal login, not Firebase Auth yet.
    // This keeps customer mobile/web and the Windows EXE synchronized.
    // Before public production, migrate portal login to Firebase Authentication
    // and tighten these rules to request.auth-based permissions.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
