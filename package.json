{
  "name": "hadi-photo-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "build:web": "vite build",
    "build:win": "vite build && electron-builder --win --x64",
    "dist": "npm run build:win"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "crypto": "^1.0.1",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^9.0.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "autoprefixer": "^10.4.21",
    "electron": "^37.1.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "main": "main.cjs",
  "author": "Hadi Studio",
  "description": "Hadi Photo Studio App",
  "build": {
    "appId": "com.hadistudio.app",
    "productName": "Hadi Photo Studio",
    "asar": true,
    "files": [
      "dist/",
      "main.cjs",
      "preload.js"
    ],
    "extraMetadata": {
      "main": "main.cjs"
    },
    "win": {
      "target": "nsis"
    }
  }
}
